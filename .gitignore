# Nothing derived from match data is ever committed (the data is gated and not redistributable).
data/
*.mp4
*.npz
*.npy
*.pkl
*.pickle
*.parquet
*.gzip
*.pl3container
# outputs: submission CSVs are whole-match labels; keep the folder, not the files
outputs/*
!outputs/.gitkeep
# ground truth of any kind (public GT included; it is fetched from the organizer repo, not copied)
*_gt*.csv
*_possession_gt*
# walkthrough figures: anything rendered from tracking is local-only (D-002)
notebooks/figs/

# caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.venv/
venv/
env/
*.egg-info/
.DS_Store
.idea/
.vscode/

# agent tooling state
.omc/

# regenerable public export (P04): build with scripts/build_walkthrough_html.py
notebooks/possession_walkthrough_public.html
# personal local reading copy with real-tracking figures: never commit, publish or upload (D-002/D-026)
notebooks/possession_walkthrough_local.html
